# Cursor projects root — contains per-workspace dirs with agent-transcripts/
CURSOR_CHAT_HISTORY_DIR=$HOME/.cursor/projects

# Cursor plans directory (optional; defaults to ~/.cursor/plans)
CURSOR_PLANS_DIR=$HOME/.cursor/plans

# Claude Code projects root (optional; defaults to ~/.claude/projects)
# CLAUDE_PROJECTS_DIR=$HOME/.claude/projects
# Or derive from CLAUDE_CONFIG_DIR:
# CLAUDE_CONFIG_DIR=$HOME/.claude

# Local SQLite index (derived cache; source transcript files remain source of truth)
AG_EXPLORER_DB_PATH=$HOME/.ag-explorer/index.sqlite

# Optional deterministic auto-extraction of knowledge candidates (default off; no LLM)
# AG_EXPLORER_AUTO_KNOWLEDGE=1
