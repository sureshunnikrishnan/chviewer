# Cursor projects root — contains per-workspace dirs with agent-transcripts/
CURSOR_CHAT_HISTORY_DIR=$HOME/.cursor/projects

# Cursor plans directory (optional; defaults to ~/.cursor/plans)
CURSOR_PLANS_DIR=$HOME/.cursor/plans

# Local SQLite index (derived cache; Cursor files remain source of truth)
AG_EXPLORER_DB_PATH=$HOME/.ag-explorer/index.sqlite
