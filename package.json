{
  "name": "chviewer",
  "version": "1.0.0",
  "description": "Terminal UI for browsing Cursor agent chat history, built with OpenTUI",
  "type": "module",
  "bin": {
    "chviewer": "./bin/chviewer.ts"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sureshunnikrishnan/chviewer.git"
  },
  "bugs": {
    "url": "https://github.com/sureshunnikrishnan/chviewer/issues"
  },
  "homepage": "https://github.com/sureshunnikrishnan/chviewer#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": ["tui", "opentui", "terminal", "cursor", "chat-history"],
  "author": "Suresh Unnikrishnan",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@opentui/core": "^0.5.11"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
