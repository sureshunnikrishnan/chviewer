{
  "name": "ag-explorer",
  "version": "1.0.0",
  "description": "Terminal explorer for AI coding sessions (Cursor-backed), built with OpenTUI",
  "type": "module",
  "bin": {
    "ag-explorer": "./bin/ag-explorer.ts"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sureshunnikrishnan/AGExplorer.git"
  },
  "bugs": {
    "url": "https://github.com/sureshunnikrishnan/AGExplorer/issues"
  },
  "homepage": "https://github.com/sureshunnikrishnan/AGExplorer#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": ["tui", "opentui", "terminal", "cursor", "chat-history"],
  "author": "Suresh Unnikrishnan",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@opentui/core": "^0.5.11"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
